# Backend base URL used by the BFF route handlers (server-only).
# Local development:
BACKEND_URL=http://localhost:8080
# Docker Compose (service name in compose.yaml):
# BACKEND_URL=http://security-camera-backend:8080
#
# Secure cookies are on by default in production. Set to true when the dashboard is
# served over HTTPS; compose defaults this to false for plain-HTTP LAN access.
# COOKIE_SECURE=true
