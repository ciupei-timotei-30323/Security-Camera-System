# Backend base URL used by the BFF when a camera system is NOT listed in EDGE_BACKENDS_JSON.
# This is the single-backend demo / single-Pi deployment fallback. It must never be a public
# hostname: the BFF only ever talks to private Tailscale / LAN / Docker-network addresses.
#
# Local development:
BACKEND_URL=http://localhost:8080
# Docker Compose (service name in compose.yaml):
# BACKEND_URL=http://security-camera-backend:8080

# Optional: systemId used for the single BACKEND_URL fallback (defaults to "default").
# BACKEND_DEFAULT_SYSTEM_ID=sys-001

# Private per-system backend map: systemId -> private URL. When set, the BFF routes each
# authenticated session to the backend of the camera system stored in its sealed cookie.
# Example Tailscale mesh:
# EDGE_BACKENDS_JSON={"sys-001":"http://100.64.0.10:8080","sys-002":"http://100.64.0.11:8080"}
# EDGE_BACKENDS_JSON=

# REQUIRED in production (at least 32 bytes). AES-256-GCM key that seals the bff_session cookie
# holding { systemId, edgeJwt, exp }. Generate with: openssl rand -base64 48
# The Next.js server refuses to start in production when this is missing or shorter than 32 bytes.
BFF_SESSION_SECRET=replace-me-with-at-least-32-random-bytes

# Extra origins allowed to make state-changing (POST/PUT/PATCH/DELETE) BFF requests, in addition
# to the request's own Host / X-Forwarded-Host. Comma-separated, no trailing slashes.
# Needed only when the dashboard is reachable through an additional public hostname.
# ALLOWED_ORIGINS=https://camera.example.com

# External factory-admin service used when a login omits systemId. The BFF validates the
# credentials against POST {EXTERNAL_AUTH_URL}/api/internal/validate-admin and then logs in to the
# returned system's private backend. Leave empty to skip factory-admin dispatch entirely.
# EXTERNAL_AUTH_URL=http://external-auth-service:3001
# INTERNAL_API_SECRET=change-me-to-a-long-random-internal-secret

# Secure cookies are on by default in production, and automatically when the request carries
# `x-forwarded-proto: https` (Cloudflare Quick Tunnel). Set explicitly to override — compose sets
# this to false for plain-HTTP LAN access.
# COOKIE_SECURE=true

# Set to true only behind a proxy that OVERWRITES X-Forwarded-For / CF-Connecting-IP (Cloudflare
# Tunnel, Traefik, Caddy). The BFF then forwards the real client address upstream so the backend's
# per-IP login limiter partitions callers instead of treating the dashboard container as one
# client. Leave false when the dashboard is exposed directly (the header would be spoofable).
# TRUST_PROXY_HEADERS=false
