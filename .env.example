# Copy to .env (same directory as compose.yaml) and fill in real values.
# .env is gitignored; never commit real secrets.
#
# Every value below is REQUIRED in a real deployment: compose.yaml deliberately provides no
# sample-secret fallbacks, and the backend refuses to start outside Development while any of the
# repository's dev values (dev-only-*, dev-pi-key-*, dev-alert-terminal-key-*, factory-pass-*,
# change-me*) are still configured. Generate secrets with `openssl rand -base64 48`.
# The stub-account block at the bottom is only used by `dotnet run` with
# ASPNETCORE_ENVIRONMENT=Development.

DB_URL="Host=ep-xxxx.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=change-me;SSL Mode=VerifyFull;Channel Binding=Require;"

# Legacy single-Pi secret used for X-Api-Key on /api/events (mapped to sys-001)
PiAuth__ApiKey=change-me
PiAuth__DefaultSystemId=sys-001
# Additional camera kits: one API key per system (leave empty to configure a single camera)
PiAuth__Systems__sys-002=change-me-too
# Alert terminals: keys that may poll GET /api/device/status
PiAuth__AlertTerminalSystems__sys-001=change-me-terminal-1
PiAuth__AlertTerminalSystems__sys-002=change-me-terminal-2

# Physical device code printed on the camera hardware (initial admin password)
Admin__DeviceCode=CAM-0000-XXXX

# HS256 signing key for dashboard JWTs; at least 32 bytes. Each Pi/backend may use its own key:
# the dashboard BFF never verifies this signature, it only forwards the token upstream.
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-bytes
# Short-lived dashboard tokens (minutes). Logout revokes the jti immediately.
Jwt__ExpirationMinutes=30

# Optional: pin this Pi/backend to its own system id. When set, a JWT whose `system_id` claim
# does not match is rejected (single-Pi deployments). Leave empty for multi-system backends.
PiAuth__NodeSystemId=

# Suspect-event e-mail alerts (compose starts Mailpit at http://localhost:8025)
Notifications__EmailCooldownSeconds=60
Notifications__DashboardBaseUrl=http://localhost:3000
Notifications__EmailRetryBaseDelayMilliseconds=1000
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__UseStartTls=false
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=alerts@security-camera.local
Smtp__FromName=Security Camera
Alarm__DurationSeconds=15

# External factory-admin service (Neon-backed Hono app in ../external-auth-service).
# compose.yaml sets ExternalAuth__UseStub=false and BaseUrl automatically.
# The same secret must be set as INTERNAL_API_SECRET in external-auth-service/.env and
# as a Cloudflare Worker secret when deployed.
NEON_DB_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
INTERNAL_API_SECRET=change-me-to-a-long-random-internal-secret

# For a direct `dotnet run` outside Compose, uncomment these and point BaseUrl at the
# service on the host (Compose sets its own values and does not read them from .env):
# ExternalAuth__UseStub=false
# ExternalAuth__BaseUrl=http://localhost:3001
# ExternalAuth__InternalSecret=change-me-to-a-long-random-internal-secret

# Restrict CORS to an explicit origin list, or leave empty. The backend has no public URL: the
# dashboard BFF is same-origin, so wildcard CORS is never needed and is not supported.
Cors__AllowedOrigins=

# Stub fallback used only when running with ExternalAuth__UseStub=true locally.
ExternalAuth__StubAccounts__cam_admin_1__SystemId=sys-001
ExternalAuth__StubAccounts__cam_admin_1__Password=change-me-factory-pass-1
ExternalAuth__StubAccounts__cam_admin_1__PiApiKey=change-me-pi-key-1
ExternalAuth__StubAccounts__cam_admin_2__SystemId=sys-002
ExternalAuth__StubAccounts__cam_admin_2__Password=change-me-factory-pass-2
ExternalAuth__StubAccounts__cam_admin_2__PiApiKey=change-me-pi-key-2

# ---------------------------------------------------------------------------------------------
# Dashboard BFF (frontend/) — the only publicly reachable service.
# ---------------------------------------------------------------------------------------------
# AES-256-GCM key (>= 32 bytes) that seals the bff_session cookie holding {systemId, edgeJwt, exp}.
# Generate with: openssl rand -base64 48
BFF_SESSION_SECRET=replace-me-with-at-least-32-random-bytes

# Private per-system backend map: systemId -> private URL (Tailscale/LAN).
# EDGE_BACKENDS_JSON={"sys-001":"http://100.64.0.10:8080"}
EDGE_BACKENDS_JSON=

# ---------------------------------------------------------------------------------------------
# Tailscale sidecar — how the Pi, ESP32 terminals and remote dashboards reach the backend.
# ---------------------------------------------------------------------------------------------
# The backend publishes no host port, so off-host clients cannot use http://<lan-ip>:8080. The
# `tailscale` compose service (profile `tailscale`) joins the tailnet from inside the backend's
# network namespace, making the backend reachable at http://$TS_HOSTNAME:8080 over the mesh.
#
#   docker compose --profile tailscale up -d
#
# Create a tagged, preferably ephemeral auth key at
# https://login.tailscale.com/admin/settings/keys (tag:tag:server). Without TS_AUTHKEY the
# container refuses to authenticate, so leave the profile off until you have one.
TS_AUTHKEY=
# Tailnet name for this backend node. Pi/ESP32 clients then use http://<this>:8080.
TS_HOSTNAME=security-camera-backend
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:server or --accept-routes.
TS_EXTRA_ARGS=

# Extra origins permitted to make state-changing BFF requests, in addition to the request Host /
# X-Forwarded-Host. Comma-separated, no trailing slashes.
ALLOWED_ORIGINS=

# Set to true only when the dashboard is served over HTTPS; compose sets false for plain-HTTP LAN.
COOKIE_SECURE=false

# Set to true only behind a proxy that OVERWRITES X-Forwarded-For / CF-Connecting-IP
# (Cloudflare Tunnel, Traefik, Caddy). The BFF then forwards the real client IP so the backend's
# per-IP login limiter partitions callers instead of counting the dashboard container as one.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------------------------
# MQTT broker (mosquitto) — event-driven alarm/event fan-out.
# ---------------------------------------------------------------------------------------------
# The broker seeds its password file from these on first start (mosquitto/entrypoint.sh), so
# change them BEFORE the first `docker compose up`; afterwards delete the mosquitto-data volume
# (or edit the passwords inside the running container) to regenerate.
#   backend   = ASP.NET Core publisher (read/write on systems/#)
#   dashboard = browser over WebSockets (read-only on systems/+/alarm and systems/+/events)
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASS=change-me-backend
MQTT_CLIENT_USER=dashboard
MQTT_CLIENT_PASS=change-me-dashboard
# Backend publisher settings (host/port default to the compose service name and 1883).
Mqtt__Host=mosquitto
Mqtt__Port=1883
Mqtt__TopicPrefix=systems

# ---------------------------------------------------------------------------------------------
# MediaMTX — RTSP ingest from the Pi + WebRTC WHEP playback in the browser.
# ---------------------------------------------------------------------------------------------
# Public origin the BROWSER uses to reach MediaMTX. The dashboard turns this into
# `<MEDIAMTX_PUBLIC_URL>/<systemId>/whep`. Leave empty to keep the dashboard on the MJPEG fallback.
MEDIAMTX_PUBLIC_URL=
# Public MQTT-over-WebSockets URL the BROWSER connects to (e.g. wss://cam.example.com/mqtt).
# Leave empty to keep the dashboard on its polling fallback.
MQTT_PUBLIC_WS_URL=
# Credentials handed to the browser in the realtime ticket. Defaults to the dashboard client above.
MQTT_PUBLIC_USER=dashboard
MQTT_PUBLIC_PASS=change-me-dashboard
