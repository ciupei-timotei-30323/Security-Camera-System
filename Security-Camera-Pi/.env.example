# Copy to .env in this directory (or use /etc/security-camera-pi.env with systemd).
# .env is gitignored; never commit the real API key.

# Backend origin, without a trailing slash. Do not include /api.
# The compose stack publishes NO host port for the backend, so a LAN IP only works when you run the
# backend yourself (`dotnet run`). For the compose deployment use the Tailscale sidecar name:
#   BACKEND_URL=http://security-camera-backend:8080
BACKEND_URL=http://security-camera-backend:8080

# Camera kit API key from the backend (PiAuth__Systems__<systemId> or PiDevices).
API_KEY=change-me-to-the-camera-api-key

# Largest contour, in pixels of the 320x180 motion image, treated as motion.
MOTION_MIN_AREA=1500

# After a trigger, ignore further motion for this many seconds.
COOLDOWN_SECONDS=8

# Seconds between live-preview uploads (~640x360 JPEG, quality 60).
PREVIEW_INTERVAL=1

# Maximum size of offline_queue/ including JPEGs and JSON sidecars.
QUEUE_MAX_MB=500

# --- Live video -----------------------------------------------------------------------------
# webrtc: publish H.264 over RTSP to MediaMTX (browser plays via WHEP, sub-second latency).
# mjpeg:  keep the original POST /api/camera/frame preview loop.
STREAM_MODE=webrtc

# Tenant id. Doubles as the MediaMTX path, so it must match this camera's SystemId.
SYSTEM_ID=sys-001

# MediaMTX RTSP host/port. RTSP_HOST defaults to the BACKEND_URL hostname when unset, but 8554 is
# published straight to the host, so set the Pi-visible address explicitly.
# The streamer builds rtsp://<RTSP_USER>:<API_KEY>@<RTSP_HOST>:<RTSP_PORT>/<SYSTEM_ID>.
RTSP_HOST=192.168.1.10
RTSP_PORT=8554
RTSP_USER=pi

# Full URL override (takes precedence over RTSP_HOST/PORT/SYSTEM_ID; supports rtsps://).
# STREAM_RTSP_URL=rtsps://pi:key@cam.example.com:8322/sys-001

# H.264 geometry and rate. Keep 1280x720/15 for Pi 5 + WebRTC.
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=15
STREAM_BITRATE_KBPS=2500

# Encoder passed to ffmpeg. h264_v4l2m2m is the Pi 5 hardware encoder; omit for libx264.
STREAM_FFMPEG_ENCODER=h264_v4l2m2m

# ffmpeg binary. MediaMTX ingest needs ffmpeg >= 6 for -rtsp_transport on the output side.
FFMPEG_PATH=ffmpeg

# Set false to stop uploading the MJPEG preview when WebRTC is in use.
PREVIEW_ENABLED=true
