# Copy to external-auth-service/.env for local seeding/development.
# Use the pooled or direct Neon PostgreSQL connection string; the serverless driver accepts
# standard postgresql:// URLs. Never commit real values.

DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Shared with the backend as ExternalAuth__InternalSecret. Generate a long random value.
INTERNAL_API_SECRET=change-me-to-a-long-random-internal-secret

# Local Node entrypoint port (Docker compose publishes only 127.0.0.1:3001).
PORT=3001

# Optional seed overrides. Defaults match the backend's development stub accounts.
SEED_CAM_ADMIN_1_PASSWORD=factory-pass-sys-001
SEED_PI_API_KEY_SYS_001=dev-pi-key-sys-001
SEED_CAM_ADMIN_2_PASSWORD=factory-pass-sys-002
SEED_PI_API_KEY_SYS_002=dev-pi-key-sys-002
