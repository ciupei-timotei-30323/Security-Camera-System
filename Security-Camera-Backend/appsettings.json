{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{MachineName}/{ProcessId}/{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "PiAuth": {
    "ApiKey": "",
    "DefaultSystemId": "sys-001",
    "Systems": {},
    "AlertTerminalSystems": {}
  },
  "Storage": {
    "CapturesDirectory": "/data/captures"
  },
  "CvService": {
    "BaseUrl": "http://cv-service:8000",
    "TimeoutSeconds": 10
  },
  "Admin": {
    "DeviceCode": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "security-camera-backend",
    "Audience": "security-camera-dashboard",
    "ExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "LoginRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "Enabled": true
    },
    "LoginLockout": {
      "MaxFailures": 5,
      "LockoutSeconds": 300,
      "Enabled": true
    }
  },
  "ExternalAuth": {
    "UseStub": false,
    "BaseUrl": "http://external-auth-service:3001",
    "TimeoutSeconds": 10,
    "InternalSecret": "",
    "StubAccounts": {}
  },
  "AllowedHosts": "*",
  "Notifications": {
    "EmailCooldownSeconds": 60,
    "DashboardBaseUrl": "http://localhost:5173",
    "EmailRetryBaseDelayMilliseconds": 1000
  },
  "Smtp": {
    "Host": "",
    "Port": 1025,
    "UseStartTls": false,
    "Username": "",
    "Password": "",
    "FromAddress": "alerts@security-camera.local",
    "FromName": "Security Camera"
  },
  "Alarm": {
    "DurationSeconds": 15
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "mosquitto",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "ClientId": "security-camera-backend",
    "TopicPrefix": "systems",
    "PublishTimeoutSeconds": 5
  }
}
