{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PiAuth": {
    "ApiKey": "dev-only-api-key",
    "DefaultSystemId": "sys-001",
    "Systems": {
      "sys-002": "dev-only-api-key-sys-002"
    },
    "AlertTerminalSystems": {
      "sys-001": "dev-alert-terminal-key-sys-001",
      "sys-002": "dev-alert-terminal-key-sys-002"
    }
  },
  "Storage": {
