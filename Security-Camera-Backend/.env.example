# Copy to .env (same directory as compose.yaml) and fill in real values.
# .env is gitignored; never commit real secrets.

DB_URL="Host=ep-xxxx.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=change-me;SSL Mode=VerifyFull;Channel Binding=Require;"

# Legacy single-Pi secret used for X-Api-Key on /api/events (mapped to sys-001)
PiAuth__ApiKey=change-me
PiAuth__DefaultSystemId=sys-001
# Additional camera kits: one API key per system
PiAuth__Systems__sys-002=change-me-too
# Alert terminals: keys that may poll GET /api/device/status
PiAuth__AlertTerminalSystems__sys-001=change-me-terminal-1
PiAuth__AlertTerminalSystems__sys-002=change-me-terminal-2

# Physical device code printed on the camera hardware (initial admin password)
Admin__DeviceCode=CAM-0000-XXXX

# HS256 signing key for dashboard JWTs; at least 32 bytes
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-bytes

# Suspect-event e-mail alerts (compose starts Mailpit at http://localhost:8025)
Notifications__EmailCooldownSeconds=60
Notifications__DashboardBaseUrl=http://localhost:5173
Notifications__EmailRetryBaseDelayMilliseconds=1000
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__UseStartTls=false
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=alerts@security-camera.local
Smtp__FromName=Security Camera
Alarm__DurationSeconds=15

# Factory-admin authentication. Keep UseStub=true until the external IAM service exists.
ExternalAuth__UseStub=true
ExternalAuth__BaseUrl=http://external-auth:8080
ExternalAuth__StubAccounts__cam_admin_1__SystemId=sys-001
ExternalAuth__StubAccounts__cam_admin_1__Password=change-me-factory-pass-1
ExternalAuth__StubAccounts__cam_admin_1__PiApiKey=change-me-pi-key-1
ExternalAuth__StubAccounts__cam_admin_2__SystemId=sys-002
ExternalAuth__StubAccounts__cam_admin_2__Password=change-me-factory-pass-2
ExternalAuth__StubAccounts__cam_admin_2__PiApiKey=change-me-pi-key-2
